 * See LICENSE file for licensing details.
 */

/**
 * Module dependencies.
 */

var app = require('../app');
var debug = require('debug')('app:server');
var http = require('http');

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || '3000');
var metricsPort = normalizePort(process.env.METRICS_PORT || '9464');
app.set('port', port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);
var metricsServer = http.createServer(app.metricsApp);

/**
 * Listen on provided port, on all network interfaces.
 */

server.listen(port);
server.on('error', function(error) {
  onError(error, port);
});
server.on('listening', onListening);
metricsServer.listen(metricsPort);
metricsServer.on('error', function(error) {
  onError(error, metricsPort);
});

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error, listeningPort) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof listeningPort === 'string'
    ? 'Pipe ' + listeningPort
    : 'Port ' + listeningPort;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
